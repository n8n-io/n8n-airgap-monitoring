{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm run build && fastify start --options -l info dist/app.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "watch": "tsc -w -p tsconfig.build.json",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch\" \"npm:dev:start\"",
    "dev:start": "fastify start --options --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.0",
    "@fastify/bearer-auth": "10.1.3",
    "@fastify/sensible": "6.0.5",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.0",
    "fastify-cli": "8.0.0",
    "fastify-plugin": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.9.5",
    "concurrently": "9.2.4",
    "fastify-tsconfig": "3.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  }
}