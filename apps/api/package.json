{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm run build && fastify start -l info dist/app.js",
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --no-errors-on-unmatched --write src",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "watch": "tsc -w -p tsconfig.build.json",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=\"data .ts$\" -w -l info -P -p 3456 dist/app.js"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "4.0.6",
    "@fastify/bearer-auth": "10.1.3",
    "@fastify/sensible": "6.0.5",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.0",
    "fastify-cli": "8.0.0",
    "fastify-plugin": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.9.5",
    "concurrently": "9.2.4",
    "fastify-tsconfig": "3.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  }
}