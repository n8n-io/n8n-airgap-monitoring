{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "license": "LicenseRef-n8n-enterprise",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "inspect": "vite --open --",
    "build": "run-p typecheck \"build-only {@}\" --",
    "test": "vitest run",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint . && prettier --check src/",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.87.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.87.0",
    "prettier": "3.9.9",
    "typescript": "catalog:vue",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
