{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["N8N_MONITORING_READ_TOKEN", "N8N_MONITORING_ADDITIONAL_ISSUER_CERTS", "N8N_DB_PATH"]
    },
    "test": {
      "dependsOn": ["typecheck"],
      "outputs": []
    },
    "format": {
      "cache": false
    }
  }
}