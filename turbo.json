{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "N8N_MONITORING_WRITE_TOKEN",
        "N8N_MONITORING_READ_TOKEN",
        "N8N_DB_PATH",
        "N8N_MONITORING_REPORT_DESTINATION",
        "N8N_MONITORING_REPORT_DESTINATION_AUTH_TOKEN"
      ]
    },
    "test": {
      "dependsOn": ["typecheck"],
      "outputs": []
    },
    "format": {
      "cache": false
    }
  }
}