{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  // Browser code is compiled by tsconfig.client.json instead: it needs the DOM
  // lib, no Node types, and a non-CommonJS emit.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.client.ts"]
}
