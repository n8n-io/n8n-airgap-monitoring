{
  "name": "airgap-monitoring",
  "version": "0.1.0",
  "description": "Aggregate usage metrics for n8n instances in airgapped environments.",
  "main": "app.ts",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "test": "pnpm run typecheck && pnpm run build:ts && node --experimental-test-coverage --test-coverage-exclude=\"src/testing/**\" --test-coverage-exclude=\"**/*.test.ts\" --test -r tsx/cjs \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "pnpm run build:ts && fastify start --options -l info dist/app.js",
    "build:ts": "tsc -p tsconfig.build.json && pnpm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "watch:ts": "tsc -w -p tsconfig.build.json",
    "watch:client": "tsc -w -p tsconfig.client.json",
    "dev": "pnpm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,Client,App\" -c \"yellow.bold,magenta.bold,cyan.bold\" \"npm:watch:ts\" \"npm:watch:client\" \"npm:dev:start\"",
    "dev:start": "fastify start --options --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/bearer-auth": "^10.1.3",
    "@fastify/sensible": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.3",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}