{
  "name": "airgap-monitoring",
  "version": "0.1.0",
  "description": "Aggregate usage metrics for n8n instances in airgapped environments.",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "license": "LicenseRef-n8n-enterprise",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm --filter api start",
    "lint": "turbo run lint:check",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "turbo": "2.10.10",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  }
}
